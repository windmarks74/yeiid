// Cloudflare Workers 배포 설정 — 랜딩 페이지(yeiid.itbrown.com) 전용.
//
// 이 레포의 본체는 Capacitor 안드로이드 앱이고, 여기서 배포하는 건 site/yeiid/ 하나뿐이다.
// 스크립트가 없는 "정적 자산 전용 Worker"라 main 항목이 없다 — assets.directory 만으로
// Cloudflare가 파일을 그대로 서빙한다.
//
// Workers Builds 설정(대시보드):
//   Build command  : (비움)
//   Deploy command : npx wrangler deploy
//
// 앱 빌드(npm run build)와는 무관하다. dist/ 를 건드리지 않는다.
{
  "name": "yeiid",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./site/yeiid"
  },

  // 커스텀 도메인을 여기서 선언한다. 배포할 때 wrangler가 itbrown.com 존을 찾아
  // 커스텀 도메인과 DNS 레코드를 자동으로 만든다.
  // (대시보드 "Add Domain" 창은 서브도메인을 못 잡고 "No zones match"를 띄운다.
  //  거기서 "Onboard domain"을 누르면 별도 존을 새로 만들려 하므로 쓰면 안 된다.)
  "routes": [
    { "pattern": "yeiid.itbrown.com", "custom_domain": true }
  ],

  // 커스텀 도메인이 살아 있으므로 workers.dev 주소와 버전별 프리뷰 URL은 닫는다.
  // 같은 페이지가 여러 주소로 색인되면 중복 콘텐츠가 되고, 검색 노출이
  // 이 랜딩의 존재 이유라 그냥 두면 손해다. (canonical 로 완화는 되지만 근본 차단이 낫다.)
  "workers_dev": false,
  "preview_urls": false
}
